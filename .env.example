# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Public URL of this API (used for upload URLs and the Google OAuth callback)
API_PUBLIC_URL=http://localhost:5000

# ---------- Database ----------
# Local MongoDB, or a MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/auctech_academy
MONGODB_URI=mongodb://127.0.0.1:27017/auctech_academy

# ---------- The two apps that may call this API (CORS + redirects) ----------
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Extra allowed origins, comma separated (e.g. a staging domain).
# Set to * to accept requests from ANY website (no CORS errors anywhere).
CORS_ORIGINS=

# ---------- Auth ----------
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---------- Razorpay (leave empty to use the simulated "demo" gateway) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → secret (events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=
# Allow the simulated payment dialog when no keys are set. Set false in production.
ALLOW_DEMO_PAYMENTS=true

# ---------- Google sign-in (optional) ----------
# Google Cloud Console → Credentials → OAuth client (Web).
# Authorized redirect URI: <API_PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Email for password reset (optional; without it the link is printed in the server log) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Auctech Academy <academy@auctech.in>

# ---------- Uploads ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=200

# ---------- Demo controls ----------
# Lets an admin wipe & re-seed the database from Admin → Settings. Set false in production.
ALLOW_DEMO_RESET=true
